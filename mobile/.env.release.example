# Copy to .env.release.local and replace every placeholder before a release build.
# VITE_ values are public and bundled into the app. Never put secrets here.
VITE_API_BASE_URL=https://api.example.com
VITE_REVENUECAT_ANDROID_API_KEY=change-me
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=change-me
VITE_REVENUECAT_CURRENT_OFFERING_ID=change-me
VITE_REVENUECAT_ANDROID_MONTHLY_PRODUCT_ID=change-me
VITE_REVENUECAT_ANDROID_YEARLY_PRODUCT_ID=change-me
VITE_GOOGLE_WEB_CLIENT_ID=change-me
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_CONTACT_EMAIL=support@example.com
VITE_SENTRY_DSN=change-me
VITE_VCONSOLE_ENABLED=false
