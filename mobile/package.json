{
  "name": "ourweek",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "health:ping": "node --env-file-if-exists=.env scripts/ping-health.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vue-tsc --noEmit && vite build --mode release",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src tests/contract",
    "test:api:live": "vitest run tests/api-live.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint",
    "cap:sync": "npm run build && cap sync android",
    "cap:sync:staging": "npm run build:staging && cap sync android",
    "cap:sync:staging:ios": "npm run build:staging && cap sync ios",
    "cap:sync:ios": "npm run build && cap sync ios",
    "cap:sync:prod": "npm run build:prod && node scripts/strip-sourcemaps.mjs && cap sync android && cap sync ios",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/local-notifications": "8.2.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/toast": "8.0.1",
    "@capawesome/capacitor-google-sign-in": "0.1.2",
    "@revenuecat/purchases-capacitor": "13.3.0",
    "@revenuecat/purchases-capacitor-ui": "13.3.0",
    "@sentry/vite-plugin": "5.4.0",
    "@sentry/vue": "10.69.0",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/devtools-api": "8.2.1",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vconsole": "3.15.1",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
