{
  "name": "weekly-us-api",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "build:agents": "node scripts/build-agents-md.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "ai:evaluate": "tsx scripts/run-ai-evaluation.ts",
    "ci": "npm run typecheck && npm test && npm run openapi:check",
    "db:migrate": "supabase db push",
    "db:migrate:dry-run": "supabase db push --dry-run",
    "db:migrate:local": "supabase db push --local",
    "db:migrate:local:dry-run": "supabase db push --local --dry-run",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@sentry/node": "10.71.0",
    "@supabase/supabase-js": "2.112.4",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "fastify-raw-body": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "googleapis": "176.0.0",
    "jose": "6.2.3",
    "nodemailer": "9.0.5",
    "openai": "7.5.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "pino-pretty": "13.1.3",
    "supabase": "2.116.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
