NODE_ENV=development
APP_ENV=local
HOST=0.0.0.0
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000
# Production must list only trusted web origins. Native mobile apps do not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Deprecated alias accepted for older deployments. Prefer CORS_ALLOWED_ORIGINS.
CORS_ORIGINS=
LOG_LEVEL=info
SENTRY_DSN=

# Background worker polling. Scale throughput with additional worker processes.
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_MAX_ATTEMPTS=5
QUEUE_MAX_CONSECUTIVE_FAILURES=10
QUEUE_HANDLER_TIMEOUT_SECONDS=600
QUEUE_DEAD_LETTER_RETENTION_DAYS=30

# Supabase server access. Never expose the service role key to clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-key

# Backend-issued auth tokens.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
PASSWORD_RESET_TOKEN_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id password hashing.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Optional AI provider keys stay backend-only. Leave blank to disable locally.
AI_PROVIDER=
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Optional RevenueCat entitlement validation. Leave blank to disable locally.
REVENUECAT_PROJECT_ID=
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_WEBHOOK_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=com.weeklyus.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=

# Optional native mobile Google Sign-In client IDs. Comma-separate Android, iOS, or web client IDs.
GOOGLE_SIGN_IN_CLIENT_IDS=

# Optional backend-owned Google OAuth client for calendar integration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional SMTP settings for password reset and invitations.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
