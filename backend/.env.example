NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase server access. Never expose the service role key to clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Backend-issued auth tokens.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Argon2id password hashing.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# AI provider keys stay backend-only.
OPENAI_API_KEY=replace-with-openai-api-key

# RevenueCat entitlement validation.
REVENUECAT_PROJECT_ID=replace-with-project-id
REVENUECAT_API_KEY=replace-with-revenuecat-api-key
REVENUECAT_WEBHOOK_SHARED_SECRET=replace-with-webhook-secret

# Backend-owned Google OAuth client for calendar integration.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/v1/calendar/oauth/callback
